FROM python:3.11-slim

WORKDIR /app

# Install lightweight dependencies needed for frontend
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir streamlit requests supabase python-dotenv

# Copy frontend codebase
COPY frontend/ ./frontend/

EXPOSE 8501

CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
